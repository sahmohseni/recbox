<resources>
    <style name="Theme.Recbox" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/iran_sans_fanum_regular</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0D0E15</item>
        <item name="android:navigationBarColor">#0D0E15</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Recbox.Transparent" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#A98BFF</item>
    </style>
</resources>
